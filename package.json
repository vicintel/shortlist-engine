{
  "name": "shortlist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Automated job vacancy funnel — collects, dedupes, scores and shortlists engineering roles against a structured profile.",
  "bin": {
    "shortlist": "./bin/shortlist.js"
  },
  "scripts": {
    "run": "node bin/shortlist.js run",
    "list": "node bin/shortlist.js list",
    "ui": "node bin/shortlist.js ui",
    "apply": "node bin/shortlist.js apply",
    "slop": "node bin/shortlist.js slop",
    "discover": "node bin/shortlist.js discover",
    "stats": "node bin/shortlist.js stats",
    "test": "node --test tests/",
    "fill": "node scripts/fill-application.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "imapflow": "^1.7.0",
    "nodemailer": "^9.0.5",
    "playwright": "^1.62.1",
    "resend": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vicintel/shortlist.git"
  }
}
