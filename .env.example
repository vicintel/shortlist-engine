# Copy to .env and fill in. .env is gitignored.

# ── Scoring provider ────────────────────────────────────────────────────────
# Leave SHORTLIST_PROVIDER unset to auto-pick the first free provider that has a
# key. Nothing that costs money is ever chosen unless you name it explicitly.
#
#   gemini      free tier, no card required          <- default, recommended
#   groq        free tier, Llama models
#   openrouter  free tier via :free model ids
#   ollama      local, no key, no network
#   anthropic   paid
#   openai      paid
SHORTLIST_PROVIDER=gemini
SHORTLIST_MODEL=gemini-3.5-flash-lite

# Requests per minute. Free tiers limit by rate, not spend — bursting past this
# just turns every call into a retry. 12 is comfortably inside Google's free tier.
SHORTLIST_RPM=12

# Jobs sent to the model per run. On a free tier this is a time lever, not a
# cost one: 25 jobs at 12 rpm is about two minutes.
SHORTLIST_LLM_BUDGET=150

# ── Provider keys (set whichever you use) ───────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OLLAMA_URL=http://localhost:11434/v1

# ── Digest email — OPTIONAL ────────────────────────────────────────────────
# Leave blank. The daily run already writes data/digest-latest.html and posts a
# macOS notification, which needs no account and no sending domain.
#
# If you do want email, use a SEPARATE account of your own — never a business's
# sending domain. A personal job hunt should not touch a company's sender
# reputation, and its mail should not be associated with that domain.
#
# Resend's free tier sends 100/day; with the default onboarding@resend.dev sender
# you can email your own address without verifying a domain at all.
# ---- Gmail (recommended: no third-party service, your account to your inbox) ----
# 1. 2-Step Verification must be ON: https://myaccount.google.com/security
# 2. Create an app password:        https://myaccount.google.com/apppasswords
#    Name it "Shortlist". Google shows 16 characters in four groups — paste as-is,
#    spaces are stripped automatically. Your normal password will NOT work.
# 3. node bin/shortlist.js mail-test
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---- Resend (alternative) ----
RESEND_API_KEY=

# Optional. DIGEST_TO defaults to GMAIL_USER — the digest goes to your own inbox.
MAIL_TRANSPORT=
DIGEST_FROM=
DIGEST_TO=
